@namespace("ru.practicum.ewm.stats.avro")
protocol EventSimilarityProtocol {

	record EventSimilarityAvro {
		long  eventA;  // иидентификатор мероприятия A
		long eventB; //  идентификатор мероприятия B;
		double  score; // значение рассчитанного сходства мероприятий;
		timestamp_ms timestamp; // когда было совершено действие, инициировавшее пересчёт.
	}

}